
module processing_element (

    input clk,
    input reset,
    input clear,
    input enable,

    input valid_in,

    input signed [7:0] a_in,
    input signed [7:0] b_in,

    output reg signed [7:0] a_out,
    output reg signed [7:0] b_out,

    output reg valid_out,

    output signed [31:0] accumulator

);

    // MAC enable only when valid data is available
    wire mac_enable;

    assign mac_enable = enable & valid_in;

    // MAC Unit
    mac_unit mac_inst (

        .clk(clk),
        .reset(reset),
        .clear(clear),
        .enable(mac_enable),

        .a(a_in),
        .b(b_in),

        .accumulator(accumulator)

    );

    // Data forwarding registers
    always @(posedge clk) begin

        if (reset) begin

            a_out <= 8'sd0;
            b_out <= 8'sd0;
            valid_out <= 1'b0;

        end

        else if (enable) begin

            a_out <= a_in;
            b_out <= b_in;
            valid_out <= valid_in;

        end

        else begin

            valid_out <= 1'b0;

        end

    end

endmodule
