
`timescale 1ns/1ps

module tb_processing_element;

    reg clk;
    reg reset;
    reg clear;
    reg enable;
    reg valid_in;

    reg signed [7:0] a_in;
    reg signed [7:0] b_in;

    wire signed [7:0] a_out;
    wire signed [7:0] b_out;

    wire valid_out;

    wire signed [31:0] accumulator;

    processing_element uut (

        .clk(clk),
        .reset(reset),
        .clear(clear),
        .enable(enable),

        .valid_in(valid_in),

        .a_in(a_in),
        .b_in(b_in),

        .a_out(a_out),
        .b_out(b_out),

        .valid_out(valid_out),

        .accumulator(accumulator)

    );

    // Clock generation
    always #5 clk = ~clk;

    initial begin

        clk = 0;
        reset = 1;
        clear = 0;
        enable = 0;
        valid_in = 0;

        a_in = 0;
        b_in = 0;

        // Reset
        @(negedge clk);
        reset = 0;
        enable = 1;

        // Test 1
        a_in = 10;
        b_in = 20;
        valid_in = 1;

        @(negedge clk);

        // Test 2
        a_in = 5;
        b_in = 4;

        @(negedge clk);

        // Test 3
        a_in = -2;
        b_in = 10;

        @(negedge clk);

        // Invalid input
        valid_in = 0;
        a_in = 100;
        b_in = 100;

        @(negedge clk);

        // Disable PE
        enable = 0;

        @(negedge clk);

        // Clear accumulator
        clear = 1;

        @(negedge clk);
        clear = 0;

        // Test after clear
        enable = 1;
        valid_in = 1;
        a_in = 7;
        b_in = 6;

        @(negedge clk);

        valid_in = 0;

        @(negedge clk);

        $finish;

    end

    initial begin

        $monitor(
        "TIME=%0t A_IN=%d B_IN=%d VALID=%b | A_OUT=%d B_OUT=%d VALID_OUT=%b | ACC=%d",
        $time,
        a_in, b_in, valid_in,
        a_out, b_out, valid_out,
        accumulator
        );

    end

endmodule
